@@ -0,0 +1,55 @@
+"""Opt-in V1 fixed-partition probability export for fidelity experiments.
+
+The existing GPU-to-CPU LogprobsTensors transport carries five internal
+metadata columns after each row's real requested IDs. Negative IDs are
+reserved ONLY inside this transport; the completion adapter removes them
+and exposes a separate sparse_fidelity object, never a fake vocabulary token.
+Sampling and model logits are not modified.
+"""
+import os
+
+import torch
+
+from vllm.v1.outputs import LogprobsTensors
+
+METADATA_IDS = (-1, -2, -3, -4, -5)
+METADATA_COUNT = len(METADATA_IDS)
+
+
+def enabled():
+    return os.environ.get("VLLM_FIDELITY_SPARSE", "0") == "1"
+
+
+def gather_sparse(logprobs, requested_ids, sampled):
+    """On-device float64 tail and mass reduction; no full D2H transfer.
+
+Metadata columns: raw tail logmass, raw total logmass, actual raw argmax ID,
+raw argmax logprob, vocabulary size. Selected values remain raw so the
+client can apply the explicitly returned normalization correction.
+"""
+    batch, vocab = logprobs.shape
+    width = max(map(len, requested_ids.values())) + 1 + METADATA_COUNT
+    ids_out = torch.full((batch, width), -99, dtype=torch.int32, device=logprobs.device)
+    values_out = torch.full((batch, width), -torch.inf, dtype=torch.float64, device=logprobs.device)
+    ids_out[:, 0] = sampled.to(torch.int32)
+    values_out[:, 0] = logprobs.gather(1, sampled[:, None]).squeeze(1).to(torch.float64)
+    ranks = (logprobs > logprobs.gather(1, sampled[:, None])).sum(dim=1).to(torch.int64) + 1
+    markers = torch.tensor(METADATA_IDS, dtype=torch.int32, device=logprobs.device)
+    for row, token_ids in requested_ids.items():
+        index = torch.tensor(token_ids, dtype=torch.int64, device=logprobs.device)
+        k = len(token_ids)
+        values = logprobs[row].to(torch.float64)
+        total = torch.logsumexp(values, dim=0)
+        top1 = torch.argmax(values)
+        selected = values[index]
+        # Full-size temporaries stay on GPU. Never use 1 - selected mass.
+        complement = values.clone()
+        complement[index] = -torch.inf
+        tail = torch.logsumexp(complement, dim=0)
+        ids_out[row, 1:k+1] = index.to(torch.int32)
+        values_out[row, 1:k+1] = selected
+        ids_out[row, k+1:k+1+METADATA_COUNT] = markers
+        values_out[row, k+1:k+1+METADATA_COUNT] = torch.stack((
+            tail, total, top1.to(torch.float64), values[top1],
+            torch.full((), vocab, dtype=torch.float64, device=values.device)))
+    return LogprobsTensors(ids_out, values_out, ranks)
